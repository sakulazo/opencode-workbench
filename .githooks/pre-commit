#!/usr/bin/env bash
# Workbench consistency check before every commit.
#
# Requires check-consistency.sh (bash 4+ and GNU coreutils). The script
# exits non-zero if any check fails, aborting the commit.

set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if [[ ! -f ./workflows/commands/check-consistency.sh ]]; then
  echo "==> Script de consistencia no encontrado: ./workflows/commands/check-consistency.sh" >&2
  exit 1
fi

if ! ./workflows/commands/check-consistency.sh; then
  echo "==> Check de consistencia fallido. Corrige las inconsistencias antes de commitear." >&2
  exit 1
fi